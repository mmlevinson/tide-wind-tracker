---
import MaterialIcon from './MaterialIcon.astro'

const { nextRoute = '' } = Astro.props
---

<div
  id="themed-splash-screen"
  class="themed-splash-screen"
  role="region"
  aria-labelledby="themed-splash-title"
  aria-label="Tide and Wind Tracker welcome"
  data-next-route={nextRoute || undefined}
>
  <div class="themed-splash-screen__scene" aria-hidden="true">
    <div class="themed-splash-screen__wave themed-splash-screen__wave--back"></div>
    <div class="themed-splash-screen__wave themed-splash-screen__wave--mid"></div>
    <div class="themed-splash-screen__wave themed-splash-screen__wave--front"></div>
    <MaterialIcon name="sailing" size="4rem" class="themed-splash-screen__icon" />
  </div>
  <div class="themed-splash-screen__content">
    <h1 id="themed-splash-title" class="themed-splash-screen__title">Tide &amp; Wind Tracker</h1>
    <p class="themed-splash-screen__tagline">Know the water before you go</p>
    <button
      type="button"
      id="themed-splash-continue"
      class="pure-button pure-button-primary themed-splash-screen__continue"
    >
      Continue to Tides
    </button>
  </div>
</div>
