---
import MaterialIcon from './MaterialIcon.astro'
import ThemedMobileMenu from './ThemedMobileMenu.astro'
import siteNav from '../data/siteNav.json'

const { currentPath = '/' } = Astro.props
---

<header class="themed-site-menubar" role="banner">
  <nav
    class="themed-site-menubar__nav themed-site-menubar__nav--desktop"
    aria-label="Primary navigation"
  >
    <ul class="themed-site-menubar__list" role="list">
      {siteNav.links.map((link) => (
        <li class="themed-site-menubar__item" role="listitem">
          <a
            href={link.href}
            class={`themed-site-menubar__link ${currentPath === link.href ? 'themed-site-menubar__link--active' : ''}`}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            <MaterialIcon name={link.icon} size="1.1rem" />
            <span>{link.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <ThemedMobileMenu currentPath={currentPath} />
</header>
