---
import MaterialIcon from './MaterialIcon.astro'
import siteNav from '../data/siteNav.json'

const { currentPath = '/' } = Astro.props
---

<header class="themed-site-menubar pure-g" role="banner">
  <div class="pure-u-1 pure-u-md-1-3 themed-site-menubar__brand">
    <a href="/" class="themed-site-menubar__brand-link" aria-label="Wind Tide Tracker home">
      <MaterialIcon name="waves" size="1.5rem" />
      <span class="themed-site-menubar__brand-text">Wind Tide Tracker</span>
    </a>
  </div>

  <nav
    class="pure-u-1 pure-u-md-2-3 themed-site-menubar__nav themed-site-menubar__nav--desktop"
    aria-label="Primary navigation"
  >
    <ul class="themed-site-menubar__list" role="list">
      {siteNav.links.map((link) => (
        <li class="themed-site-menubar__item" role="listitem">
          <a
            href={link.href}
            class={`themed-site-menubar__link ${currentPath === link.href ? 'themed-site-menubar__link--active' : ''}`}
            aria-current={currentPath === link.href ? 'page' : undefined}
          >
            <MaterialIcon name={link.icon} size="1.1rem" />
            <span>{link.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
